# Read by the runbook's bin/deploy on monster. No secrets: those are in deploy/.env.
# The tailnet name, not a host port: the app publishes none, so the health check
# goes through the sidecar like every player does.
DEPLOY_URL=https://sudoku-sensei.tail3d5daf.ts.net
# What bin/deploy waits on: the database answering, not just the home page.
DEPLOY_HEALTH_URL=https://sudoku-sensei.tail3d5daf.ts.net/api/health
